# ===========================================
# Docker 中间件环境变量配置模板
# 复制此文件为 .env 并修改为你的密码
# cp .env.example .env
# ===========================================

# MySQL 5.7
MYSQL57_ROOT_PASSWORD=root123456
MYSQL57_DATABASE=default
MYSQL57_USER=devuser
MYSQL57_PASSWORD=devpassword

# MySQL 8
MYSQL8_ROOT_PASSWORD=root123456
MYSQL8_DATABASE=default
MYSQL8_USER=devuser
MYSQL8_PASSWORD=devpassword

# PostgreSQL
POSTGRES_PASSWORD=postgres123456
POSTGRES_DB=default
POSTGRES_USER=devuser

# Redis
REDIS_PASSWORD=devredis123

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# MongoDB
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=root123456

# Elasticsearch
ES_JAVA_OPTS=-Xms512m -Xmx512m
ES_PASSWORD=dev_es_123
